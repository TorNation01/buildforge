{
  "name": "buildforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cf:preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@react-email/render": "^2.0.7",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "wrangler": "^4.84.1"
  }
}
