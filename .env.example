# Resend — BOTH required for the signup form to work
# 1. Create key at https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# 2. Create audience at https://resend.com/audiences — copy its ID
RESEND_AUDIENCE_ID=

# Optional — email yourself on each signup
# RESEND_FROM must be an address on a verified domain in Resend
# Without a verified domain, use onboarding@resend.dev (sends to your Resend login email only)
NOTIFY_EMAIL=
RESEND_FROM=

# Stripe — required for the pricing checkout buttons
# 1. Secret key from https://dashboard.stripe.com/apikeys (use restricted key in prod)
STRIPE_SECRET_KEY=sk_test_xxx

# 2. Price IDs from https://dashboard.stripe.com/products — create three products:
#    - One-Off ($9 one-time payment)
#    - Builder ($19/mo recurring subscription)
#    - Agency ($49/mo recurring subscription)
#    Copy each "price_..." ID into the matching var below.
STRIPE_PRICE_ONEOFF=price_xxx
STRIPE_PRICE_BUILDER=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# Optional — absolute site URL used for Stripe success/cancel redirects.
# If unset, the app infers it from the incoming request origin (usually fine).
# SITE_URL=https://buildforge.anakatechllc.com

# Admin unlock — comma-separated list of codes that grant full library access
# Share a URL like: https://buildforge.anakatechllc.com/unlock/FAMILY2026
# Revoke by removing the code from this list and redeploying.
ADMIN_ACCESS_CODES=FAMILY2026,VIP-LAUNCH
