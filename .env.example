# Resend — BOTH required for the signup form to work
# 1. Create key at https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# 2. Create audience at https://resend.com/audiences — copy its ID
RESEND_AUDIENCE_ID=

# Optional — email yourself on each signup
# RESEND_FROM must be an address on a verified domain in Resend
# Without a verified domain, use onboarding@resend.dev (sends to your Resend login email only)
NOTIFY_EMAIL=
RESEND_FROM=
